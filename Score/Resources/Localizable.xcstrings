          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "For the one open slot Score takes the best elective basic course result."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "For the %lld open slots Score takes the best elective basic course results."
                }
