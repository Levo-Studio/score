    "Kernfächer sind nicht abwählbar und zählen immer — auch dann, wenn sie schlechter stehen als ein Basisfach. Score hat vorausgewählt, was üblich ist.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernfächer sind nicht abwählbar und zählen immer — auch dann, wenn sie schlechter stehen als ein Basisfach. Score hat vorausgewählt, was üblich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core subjects cannot be dropped and always count — even when they stand worse than a basic course. Score has preselected the usual ones."
          }
        }
      }
    },
    "Kernfächer zählen, wie sie stehen. Auch ein schwaches Ergebnis bleibt drin — abwählen geht hier nicht.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernfächer zählen, wie sie stehen. Auch ein schwaches Ergebnis bleibt drin — abwählen geht hier nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core subjects count exactly as they stand. Even a weak result stays in — there is no dropping them."
          }
        }
      }
    },
