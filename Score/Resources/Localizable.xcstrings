    "Leistungs- und Kernfächer zählen immer. Basisfächer treten gegeneinander an — nur die besten füllen die freien Plätze in Block I.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leistungs- und Kernfächer zählen immer. Basisfächer treten gegeneinander an — nur die besten füllen die freien Plätze in Block I."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced courses and core subjects always count. Basic courses compete with each other — only the best ones fill the free slots in Block I."
          }
        }
      }
    },
