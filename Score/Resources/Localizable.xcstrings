                  "value" : "Nach den gesetzten Kursen bleibt %lld Platz. Er geht nach Punktzahl an die Wahl-Basisfächer — hier stehen sie in genau der Reihenfolge, in der Score sie vergibt."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Nach den gesetzten Kursen bleiben %lld Plätze. Sie gehen nach Punktzahl an die Wahl-Basisfächer — hier stehen sie in genau der Reihenfolge, in der Score sie vergibt."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "After the fixed courses %lld slot is left. It goes to the elective basic courses by points — they are listed in exactly the order Score fills them."
                }
              },
              "other" : {
