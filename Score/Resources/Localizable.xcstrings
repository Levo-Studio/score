    "iCloud ist auf diesem Gerät eingeschränkt. Prüf in den Systemeinstellungen, ob iCloud Drive für Score erlaubt ist.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist auf diesem Gerät eingeschränkt. Prüf in den Systemeinstellungen, ob iCloud Drive für Score erlaubt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is restricted on this device. Check in System Settings whether iCloud Drive is allowed for Score."
          }
        }
      }
    },
