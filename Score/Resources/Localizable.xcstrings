        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Halbjahre sind anrechnungspflichtig — ohne die Angabe rechnet Score zu gut. Noch nicht entschieden? Dann später in der Fächerliste."
          }
