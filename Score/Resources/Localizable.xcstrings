        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes your profile, %1$#@subjects@ and %2$#@entries@ — from this device and from your iCloud, and therefore from your other devices too. We run no server of our own, so nothing is left behind there. This cannot be undone."
          },
