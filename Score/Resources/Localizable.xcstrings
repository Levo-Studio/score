    "Danach kommen die Basisfächer: erst die, die du belegen musst, dann die, die du frei dazuwählst." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach kommen die Basisfächer: erst die, die du belegen musst, dann die, die du frei dazuwählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The basic courses come next: first the ones you have to take, then the ones you pick yourself."
          }
        }
      }
    },
