    "Das mündliche Ergebnis zählt vierfach." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das mündliche Ergebnis zählt vierfach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The oral result counts fourfold."
          }
        }
      }
    },
    "Das mündliche Ergebnis zählt vierfach. Solange es fehlt, rechnet Score die Prüfung auf deinem heutigen Stand hoch." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das mündliche Ergebnis zählt vierfach. Solange es fehlt, rechnet Score die Prüfung auf deinem heutigen Stand hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The oral result counts fourfold. While it is missing, Score projects the exam from where you stand today."
          }
        }
      }
    },
    "Das schriftliche Ergebnis zählt vierfach. Kommt eine mündliche Nachprüfung hinzu, zählen beide im Verhältnis 2 : 1." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das schriftliche Ergebnis zählt vierfach. Kommt eine mündliche Nachprüfung hinzu, zählen beide im Verhältnis 2 : 1."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The written result counts fourfold. If an additional oral exam is added, the two count in a ratio of 2 : 1."
          }
        }
      }
    },
    "Das schriftliche Ergebnis zählt vierfach. Solange es fehlt, rechnet Score die Prüfung auf deinem heutigen Stand hoch." : {
