    "Nicht abwählbar. Score klammert hier nie von sich aus — auch ein schwaches Pflicht-Basisfach bleibt drin." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht abwählbar. Score klammert hier nie von sich aus — auch ein schwaches Pflicht-Basisfach bleibt drin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot be dropped. Score never brackets here on its own — even a weak required basic course stays in."
          }
        }
      }
    },
    "Nicht gewertet" : {
      "extractionState" : "manual",
      "localizations" : {
