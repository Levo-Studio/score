          }
        }
      }
    },
    "Daten exportieren" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daten exportieren"
          }
        },
        "en" : {
